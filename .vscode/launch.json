    "version": "0.2.0",
    "configurations": [
        {
            "name": "Jaspr: servidor (Dart)",
            "type": "dart",
            "request": "launch",
            "cwd": "public",
            "program": "lib/main.server.dart"
        },
        {
            "name": "Jaspr: debug en Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/public"
        }
    ],
    "compounds": [
        {
            "name": "Jaspr: servidor + Chrome",
            "configurations": [
                "Jaspr: servidor (Dart)",
                "Jaspr: debug en Chrome"
            ]
        }
    ]
}
