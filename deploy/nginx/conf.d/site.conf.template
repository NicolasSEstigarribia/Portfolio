server {
  listen 80;
  server_name ${DOMAIN} www.${DOMAIN};

  # Ruta que usa Certbot para el challenge HTTP.
  # Certbot escribe los archivos de verificación aquí cuando se usa el modo webroot.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  # Mientras todavía no existe el certificado SSL, servimos la app estática
  # directamente por HTTP desde el contenedor `app`.
  location / {
    proxy_pass http://app:80;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

